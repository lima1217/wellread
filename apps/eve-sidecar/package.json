{
  "name": "@wellread/eve-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loopback eve-compatible sidecar for wellread (Reading Assistant).",
  "scripts": {
    "start": "NODE_PATH=.output/node_modules node .output/server/index.mjs",
    "build": "node scripts/build.mjs",
    "vendor-node": "node scripts/vendor-node.mjs",
    "dod:static": "node scripts/dod-static-check.mjs",
    "test": "node --test src/**/*.test.mjs src/**/**/*.test.mjs eval/**/*.test.mjs scripts/build.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@wellread/eve-message": "workspace:*",
    "@wellread/extract-contract": "workspace:*",
    "@wellread/quote-wire": "workspace:*",
    "@wellread/reading-context": "workspace:*",
    "ai": "^5.0.0",
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=24"
  }
}
